# ============================================
# Frontend .gitignore — Vite + React
# ============================================

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example

# ---------- Dependencies ----------
node_modules/

# ---------- Build Output ----------
dist/
dist-ssr/
build/
*.local

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- IDE & Editor ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Test & Coverage ----------
coverage/
*.lcov
